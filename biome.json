{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/test-results",
			"!**/playwright-report",
			"!**/drizzle/meta",
			"!artifacts",
			"!apps/desktop/build",
			"!apps/desktop/release",
			"!.local",
			"!bun.lock",
			"!docs/research-snapshots",
			"!docs/design/finn_pet",
			"!apps/web/src/routeTree.gen.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
