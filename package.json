{
	"name": "day-one",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": "1.4.2"
	},
	"scripts": {
		"preinstall": "bun scripts/require-bun.ts",
		"setup": "bun scripts/setup-worktree.ts",
		"dev": "bun tools/dev/src/cli.ts up",
		"dev:stop": "bun tools/dev/src/cli.ts stop",
		"dev:status": "bun tools/dev/src/cli.ts status",
		"dev:env": "bun tools/dev/src/cli.ts env",
		"doctor": "bun tools/dev/src/cli.ts doctor",
		"start": "bun apps/api/src/index.ts",
		"build": "bun run --cwd apps/web build",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "bun run routes:generate && bun run --parallel typecheck:browser typecheck:runtime",
		"check": "bun scripts/check.ts",
		"boundaries": "bun scripts/boundaries.ts",
		"test": "bun test apps/api/test apps/web/src features packages/ai/test packages/http/src packages/server/src tools/dev/test scripts --bail",
		"test:watch": "bun test --watch apps/api/test apps/web/src features packages/ai/test packages/http/src packages/server/src tools/dev/test scripts",
		"test:e2e": "bun run --cwd tools/e2e test",
		"test:isolation": "bun tools/dev/isolation.ts",
		"db:generate": "bun run --cwd packages/db generate",
		"db:migrate": "bun run --cwd packages/db migrate",
		"db:seed": "bun run --cwd packages/db seed",
		"video:doctor": "python3 tools/video/video.py doctor",
		"video:make": "python3 tools/video/video.py make",
		"video:sample": "python3 tools/video/video.py sample",
		"video:install": "bun run --cwd tools/e2e install-browser",
		"video:install-local": "python3 tools/video/video.py install-local",
		"video:test": "python3 -m unittest discover -s tools/video -p \"test_*.py\"",
		"routes:generate": "bun run --cwd apps/web routes:generate",
		"typecheck:browser": "tsc -p tsconfig.browser.json",
		"typecheck:runtime": "tsc -p tsconfig.json"
	},
	"dependencies": {},
	"overrides": {
		"yaml": "2.9.1",
		"inline-style-parser": "0.2.9"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"typescript": "6.0.3"
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"features/*",
			"packages/*",
			"tools/*"
		],
		"catalog": {
			"@tanstack/react-query": "5.104.3",
			"drizzle-orm": "0.45.4",
			"hono": "4.13.13",
			"react": "19.3.0",
			"typebox": "1.3.27",
			"zod": "4.6.7"
		}
	}
}
