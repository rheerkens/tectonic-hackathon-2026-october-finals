# Development uses synthetic identities. Set AUTH_MODE=clerk for production later.
AUTH_MODE=dev
# Optional for local Clerk integration; never needed for synthetic users.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Existing Codex login on this host; unset uses ~/.codex/auth.json.
CODEX_AUTH_FILE=
# Unset keeps the previous project's model default.
CHAT_MODEL=gpt-6-luna
# Optional video narration. Auto chooses ElevenLabs when this is configured.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
NARRATION_MODE=auto
# Piper installed outside app dependencies; local voice model path.
PIPER_MODEL=
