{
	"name": "@day-one/desktop",
	"version": "0.1.0",
	"private": true,
	"main": "main.cjs",
	"scripts": {
		"start": "AUTH_MODE=dev bun run --cwd ../.. build && electron .",
		"dist": "AUTH_MODE=dev bun run --cwd ../.. build && bun build ../api/src/index.ts --compile --outfile build/api && electron-builder --publish never"
	},
	"devDependencies": {
		"electron": "44.5.1",
		"electron-builder": "26.17.0"
	},
	"build": {
		"appId": "dev.dayone.desktop",
		"productName": "Day One",
		"directories": {
			"output": "release"
		},
		"files": [
			"main.cjs",
			"preload.cjs"
		],
		"extraResources": [
			{
				"from": "build",
				"to": "bin"
			},
			{
				"from": "../web/dist",
				"to": "app-root/apps/web/dist"
			},
			{
				"from": "../../packages/db/drizzle",
				"to": "app-root/packages/db/drizzle"
			}
		],
		"mac": {
			"target": [
				"dmg"
			],
			"identity": null
		},
		"win": {
			"target": [
				"portable"
			]
		}
	}
}
